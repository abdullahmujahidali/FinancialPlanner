{
  "name": "trusses",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.mts",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.mts",
    "db:migrate:prod": "DATABASE_URL=\"$(grep -oE 'postgresql?://[^ ]+' .env.prod-backup | head -1)\" tsx scripts/migrate.mts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/nextjs": "^11.4.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.47.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
